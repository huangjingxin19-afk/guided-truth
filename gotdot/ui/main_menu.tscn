[gd_scene format=3]

[ext_resource type="Script" path="res://ui/main_menu.gd" id="1"]
[ext_resource type="Theme" path="res://ui/investigation_theme.tres" id="2"]

[node name="MainMenu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.075, 0.105, 0.105, 1)

[node name="BackgroundArt" type="TextureRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
expand_mode = 1
stretch_mode = 6

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
theme_override_constants/separation = 18

[node name="TitleArt" type="TextureRect" parent="Center/Content"]
visible = false
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 50
text = "被引向的真相"
horizontal_alignment = 1

[node name="Actions" type="VBoxContainer" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="ContinueButton" type="Button" parent="Center/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 56)
layout_mode = 2
size_flags_horizontal = 4
mouse_default_cursor_shape = 2
text = "继续调查"

[node name="NewGameButton" type="Button" parent="Center/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 56)
layout_mode = 2
size_flags_horizontal = 4
mouse_default_cursor_shape = 2
text = "开始新游戏"

[node name="Confirmation" type="VBoxContainer" parent="Center/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 12

[node name="Warning" type="Label" parent="Center/Content/Confirmation"]
layout_mode = 2
text = "开始新游戏会覆盖现有的调查进度。"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Center/Content/Confirmation"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 12

[node name="CancelButton" type="Button" parent="Center/Content/Confirmation/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 52)
layout_mode = 2
mouse_default_cursor_shape = 2
text = "取消"

[node name="ConfirmButton" type="Button" parent="Center/Content/Confirmation/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(158, 52)
layout_mode = 2
mouse_default_cursor_shape = 2
text = "覆盖并开始"

[node name="Notice" type="Label" parent="Center/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.76, 0.64, 1)
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1
autowrap_mode = 3

[connection signal="pressed" from="Center/Content/Actions/ContinueButton" to="." method="_start_game" binds=[false]]
[connection signal="pressed" from="Center/Content/Actions/NewGameButton" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="Center/Content/Confirmation/Buttons/CancelButton" to="." method="_on_cancel_pressed"]
[connection signal="pressed" from="Center/Content/Confirmation/Buttons/ConfirmButton" to="." method="_start_game" binds=[true]]
