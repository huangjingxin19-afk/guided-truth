[resource]
script = ExtResource("1")
id = &"shelter_return_message"
title = "门铃旁的留言"
description = "留言盒里最上面是一张旧退还回执。背面有人用铅笔写下：\n\n「12，脚有一个白的。韩老师在的话我再来。」\n\n去前台核对借用卡，找出编号和白脚都对得上的物件。"
