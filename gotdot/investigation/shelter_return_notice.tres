[resource]
script = ExtResource("1")
id = &"shelter_return_notice"
title = "借用物交回通知"
description = "「旧楼周六结束借还。散场前可在后院由原经手人签收。」\n周闻从交接公告下方取来原件，用韩素的杯子压住。公示夹留有斜贴角，邵宁提醒他贴回去。\n周闻指了指「散场前」：「他肯来，韩姐在后院签就行。」"
preview = ExtResource("2")
preview_scale = 4
